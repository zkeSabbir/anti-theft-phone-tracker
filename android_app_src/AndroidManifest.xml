<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mysecurity.tracker">

    <!-- সিকিউরিটি এবং জিপিএস পারমিশনসমূহ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- অফলাইন এসএমএস ও সিম ট্র্যাকিং পারমিশন -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.camera.autofocus" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Device Protector"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- ১. ভুল পাসওয়ার্ড ডিটেকশন -->
        <receiver
            android:name=".MyDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.ACTION_PASSWORD_FAILED" />
                <action android:name="android.app.action.ACTION_PASSWORD_SUCCEEDED" />
            </intent-filter>
        </receiver>

        <!-- ২. অফলাইন এসএমএস কমান্ড রিসিভার (#LOC#, #SIREN#, #FAKEOFF#) -->
        <receiver
            android:name=".SmsCommandReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ৩. চোরের সিম কার্ড পরিবর্তন ট্র্যাকার -->
        <receiver
            android:name=".SimChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.SIM_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ৪. ফেক শাটডাউন ফুলস্ক্রিন অ্যাক্টিভিটি (Volume Up + Down সিক্রেট ওয়েকআপ) -->
        <activity
            android:name=".FakeShutdownActivity"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <!-- ৫. ব্যাকগ্রাউন্ড সার্ভিস: নিঃশব্দে ফটো তোলা ও সার্ভার সিঙ্ক -->
        <service
            android:name=".IntruderCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location|camera" />

    </application>
</manifest>
